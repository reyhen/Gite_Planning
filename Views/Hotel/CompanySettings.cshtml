@model Gite_Planning.Models.CompanySettings
@{
    ViewData["Title"] = "Paramétrage entreprise";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h2 class="mb-0">Paramétrage de l'entreprise</h2>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-action="CompanySettings" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label" for="CompanyName">Nom de l'entreprise</label>
                            <input asp-for="CompanyName" class="form-control" id="CompanyName" placeholder="Hotelia" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="CompanySubtitle">Sous-titre</label>
                            <input asp-for="CompanySubtitle" class="form-control" id="CompanySubtitle" placeholder="Gestion hôtel" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="logoFile">Télécharger le logo</label>
                            <input type="file" name="logoFile" id="logoFile" class="form-control" accept="image/*" />
                            <div class="form-text">Le fichier est enregistré dans le dossier public /images/uploads et sera affiché automatiquement.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="LogoImageUrl">URL du logo</label>
                            <input asp-for="LogoImageUrl" class="form-control" id="LogoImageUrl" placeholder="/images/logo-hotelia.svg" />
                            <div class="form-text">Exemple : /images/logo-hotelia.svg ou /images/uploads/logo.png. Laissez vide si vous utilisez un fichier uploadé.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                            <a href="/" class="btn btn-outline-secondary">Retour</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
