@model Gite_Planning.Models.HostForm
@{
    ViewData["Title"] = "Modifier un hébergement";
    var hostId = ViewData["HostId"];
}

<div class="edit-host-container">
    <div class="edit-host-card">
        <h1>Modifier un hébergement</h1>

        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@ViewData["ErrorMessage"]</div>
        }

        <form asp-controller="Hotel" asp-action="EditHost" asp-route-id="@hostId" method="post" class="edit-host-form">
            <div class="form-group">
                <label for="Name">Nom *</label>
                <input id="Name" name="Name" type="text" value="@Model.Name" required />
            </div>
            <div class="form-group">
                <label for="PhoneNumber">Téléphone *</label>
                <input id="PhoneNumber" name="PhoneNumber" type="tel" value="@Model.PhoneNumber" required />
            </div>
            <div class="form-group">
                <label for="Email">E-mail *</label>
                <input id="Email" name="Email" type="email" value="@Model.Email" required />
            </div>
            <div class="form-group">
                <label for="Address">Adresse *</label>
                <textarea id="Address" name="Address" rows="3" required>@Model.Address</textarea>
            </div>
            <div class="form-actions">
                <a href="/Hotel/Hosts" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-save">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

<style>
.edit-host-container {
    max-width: 680px;
    margin: 2rem auto;
    padding: 0 1rem 2rem;
}

.edit-host-card {
    padding: 2rem;
    background: #ffffff;
    border: 1px solid #dfe7f4;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(31, 41, 55, 0.1);
}

.edit-host-card h1 {
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #4f46e5;
    color: #1f2937;
}

.edit-host-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.form-group label {
    color: #374151;
    font-weight: 600;
}

.form-group input,
.form-group textarea {
    padding: 0.65rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font: inherit;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 0.5rem;
}

.btn-cancel,
.btn-save {
    padding: 0.65rem 1rem;
    border: 0;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
}

.btn-cancel { background: #64748b; }
.btn-save { background: #4f46e5; }
</style>
